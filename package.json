{
  "name": "touchline-studio",
  "productName": "Touchline Studio",
  "version": "1.0.0",
  "description": "Record and edit football tactical-analysis videos: facecam + screen recorder and a simple clip editor.",
  "author": "Naveen Narayan",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "test:export": "node test/export.test.js"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.naveen.touchlinestudio",
    "productName": "Touchline Studio",
    "directories": { "output": "dist" },
    "files": [
      "**/*",
      "!test/**",
      "!dist/**",
      "!node_modules/ffprobe-static/bin/darwin/**",
      "!node_modules/ffprobe-static/bin/linux/**",
      "!node_modules/ffprobe-static/bin/win32/ia32/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Touchline Studio"
    }
  }
}
